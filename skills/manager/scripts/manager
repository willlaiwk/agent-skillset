#!/usr/bin/env python3
"""Local manager runtime. Python 3.9+, POSIX, Git, tmux; no service required."""
import argparse
import contextlib
import datetime as dt
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import signal
import secrets
import subprocess
import sys
import tempfile
import time
import uuid

sys.dont_write_bytecode = True
from lib import adapter
from lib.namespace import Namespace, generated_id, manager_id, reject_symlinks

HERE = Path(__file__).resolve()
SKILL = HERE.parent.parent
STATES = {"queued", "working", "needs_manager", "needs_user", "verification",
          "done", "failed", "cancelled"}
WORKER_STATES = STATES - {"queued", "needs_user"}
READ_FILES = None
READ_DIRS = None
DEFAULTS = {
    "manager": {"max_workers": 4, "stale_seconds": 900, "max_retries": 2},
    "agents": {"default": "auto"},
    "git": {"isolation": "worktree", "auto_commit": True,
            "auto_merge": False, "auto_push": False},
    "verification": {},
    "escalation": {"product_decisions": "ask", "architecture": "recommend_then_ask",
                   "destructive_actions": "always_ask"},
}


class Error(Exception):
    pass


def now():
    return dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds")


def emit(value):
    print(json.dumps(value, ensure_ascii=False, indent=2))


def run(argv, cwd=None, check=True, data=None):
    environment = dict(os.environ)
    if str(argv[0]) == "git":
        environment["GIT_OPTIONAL_LOCKS"] = "0"
    try:
        result = subprocess.run([str(x) for x in argv], cwd=cwd, input=data,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                env=environment, timeout=30)
    except subprocess.TimeoutExpired as exc:
        raise Error("Command timed out: " + str(argv[0])) from exc
    except OSError as exc:
        raise Error(str(exc)) from exc
    if check and result.returncode:
        raise Error(result.stderr.decode(errors="replace").strip() or
                    "Command failed: " + shlex.join([str(x) for x in argv]))
    return result


def git(root, *args):
    return run(["git", "-C", root, *args]).stdout.decode(errors="surrogateescape").strip()


def read_bytes(path):
    reject_symlinks(path)
    content = path.read_bytes()
    if READ_FILES is not None:
        if path in READ_FILES and READ_FILES[path] != content:
            raise Error("Runtime busy/inconsistent read: " + str(path))
        READ_FILES[path] = content
    return content


def read_json(path):
    try:
        content = read_bytes(path)
        value = json.loads(content)
        if not isinstance(value, dict):
            raise ValueError("expected an object")
        return value
    except (OSError, ValueError) as exc:
        raise Error("Cannot read " + str(path) + ": " + str(exc)) from exc


def read_directory(path):
    reject_symlinks(path)
    entries = sorted(path.iterdir(), key=lambda p: p.name)
    if READ_DIRS is not None:
        names = tuple(p.name for p in entries)
        if path in READ_DIRS and READ_DIRS[path] != names:
            raise Error("Runtime busy/inconsistent inventory: " + str(path))
        READ_DIRS[path] = names
    return entries


def check_read_consistency():
    for path, expected in (READ_FILES or {}).items():
        reject_symlinks(path)
        if path.read_bytes() != expected:
            raise Error("Runtime busy/inconsistent read; retry: " + str(path))
    for path, expected in (READ_DIRS or {}).items():
        reject_symlinks(path)
        if tuple(sorted(p.name for p in path.iterdir())) != expected:
            raise Error("Runtime busy/inconsistent inventory; retry: " + str(path))


def atomic_text(path, content):
    reject_symlinks(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.is_symlink():
        raise Error("Refusing symlink: " + str(path))
    fd, temporary = tempfile.mkstemp(prefix=".write-", dir=str(path.parent))
    try:
        if path.exists():
            os.fchmod(fd, path.stat().st_mode & 0o777)
        with os.fdopen(fd, "w") as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        sync_directory(path.parent)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def sync_directory(path):
    fd = os.open(path, os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def atomic_json(path, value):
    atomic_text(path, json.dumps(value, ensure_ascii=False, indent=2) + "\n")


@contextlib.contextmanager
def lock(path, nonblocking=False):
    reject_symlinks(path)
    with path.open("a") as stream:
        deadline = time.monotonic() + 5
        while True:
            try:
                fcntl.flock(stream, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if nonblocking or time.monotonic() >= deadline:
                    raise Error("Runtime busy: " + str(path))
                time.sleep(0.05)
        try:
            yield
        finally:
            fcntl.flock(stream, fcntl.LOCK_UN)


def task_id(value):
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]{0,63}", value):
        raise argparse.ArgumentTypeError("Task IDs use 1–64 letters, digits, '_' or '-'")
    return value


def config(root):
    result = json.loads(json.dumps(DEFAULTS))
    path = root / ".manager.yml"
    if path.exists():
        raw = path.read_text()
        try:
            supplied = json.loads(raw)
        except ValueError:
            try:
                import yaml
            except ImportError as exc:
                raise Error("YAML configuration requires PyYAML in this Python environment; "
                            "install it explicitly or use JSON syntax in .manager.yml") from exc
            try:
                supplied = yaml.safe_load(raw)
            except yaml.YAMLError as exc:
                raise Error("Invalid .manager.yml: " + str(exc)) from exc
        if not isinstance(supplied, dict):
            raise Error(".manager.yml must be a mapping")
        for section, values in supplied.items():
            if section not in result or not isinstance(values, dict):
                raise Error("Unsupported configuration section: " + str(section))
            allowed = set(DEFAULTS[section])
            if section == "agents":
                allowed |= {"research", "implementation", "review", "verification"}
            if section == "verification":
                allowed = {"test", "typecheck", "lint", "build"}
            if set(values) - allowed:
                raise Error("Unsupported keys in " + section)
            result[section].update(values)
    for key in ("max_workers", "stale_seconds", "max_retries"):
        value = result["manager"][key]
        if type(value) is not int or value < (0 if key == "max_retries" else 1):
            raise Error("manager." + key + " has an invalid integer value")
    for value in result["agents"].values():
        if value not in ("auto", "codex", "claude"):
            raise Error("agents values must be auto, codex, or claude")
    if result["git"]["isolation"] != "worktree":
        raise Error("MVP supports only git.isolation: worktree")
    for key in ("auto_commit", "auto_merge", "auto_push"):
        if type(result["git"][key]) is not bool:
            raise Error("git." + key + " must be boolean")
    if result["git"]["auto_merge"] or result["git"]["auto_push"]:
        raise Error("MVP does not automatically merge or push")
    if any(not isinstance(v, str) or not v.strip() for v in result["verification"].values()):
        raise Error("verification commands must be nonempty strings")
    for key, value in result["escalation"].items():
        if value != DEFAULTS["escalation"][key]:
            raise Error("MVP supports the documented escalation defaults only")
    return result


def run_checks(evidence, tree, commands, timeout, home):
    checks = []
    execution_error = None
    try:
        for index, command in enumerate(commands):
            output = evidence / (str(index + 1) + ".log")
            timed_out = False
            with output.open("wb") as stream:
                environment = dict(os.environ)
                environment.pop("MANAGER_OWNER_FILE", None)
                process = subprocess.Popen(command, shell=True, executable="/bin/sh",
                                           cwd=tree, stdout=stream, env=environment,
                                           stderr=subprocess.STDOUT, start_new_session=True)
                try:
                    code = process.wait(timeout=timeout)
                except subprocess.TimeoutExpired:
                    timed_out = True
                    os.killpg(process.pid, signal.SIGTERM)
                    try:
                        process.wait(timeout=5)
                    except subprocess.TimeoutExpired:
                        os.killpg(process.pid, signal.SIGKILL)
                        process.wait()
                    code = 124
                except BaseException:
                    os.killpg(process.pid, signal.SIGTERM)
                    raise
            checks.append({"command": command, "exit_code": code, "timed_out": timed_out,
                           "log": str(output.relative_to(home))})
    except (Error, OSError, ValueError) as exc:
        execution_error = str(exc)
    return checks, execution_error


class Runtime:
    def __init__(self, root, identity=None, inventory=False):
        self.root = Path(git(Path(root).resolve(), "rev-parse", "--show-toplevel")).resolve()
        common = Path(git(self.root, "rev-parse", "--git-common-dir"))
        self.common = (common if common.is_absolute() else self.root / common).resolve()
        self.namespace = Namespace(self.root, self.common, identity)
        if not inventory:
            self.namespace.legacy_check()
        self.manager_id = identity
        self.home = self.namespace.home
        self.key = self.namespace.key
        self.control = self.namespace.control
        self.state = None
        self.busy_tasks = set()
        self.integration_locked = False
        if self.home is None:
            return
        self.state_path = self.home / "state.json"
        self.session = self.namespace.session

    def load(self):
        self.namespace.validate_layout()
        self.state = read_json(self.state_path)
        if (type(self.state.get("version")) is not int or self.state["version"] != 2
                or not self.namespace.matches(self.state)
                or self.state.get("project_key") != self.key
                or self.state.get("git_common_dir") != str(self.common)
                or self.state.get("session") != self.session):
            raise Error("Unsupported state version or mismatched manager identity; preserve and repair state")
        if self.state.get("migration"):
            raise Error("Migration pending; inspect its journal and resume explicitly")
        self.owner()
        if not isinstance(self.state.get("tasks"), dict):
            raise Error("Invalid task registry")
        for identity, item in self.state["tasks"].items():
            try:
                task_id(identity)
            except argparse.ArgumentTypeError as exc:
                raise Error("Invalid persisted task ID") from exc
            if not isinstance(item, dict) or not isinstance(item.get("state"), str) or item["state"] not in STATES:
                raise Error("Invalid task record: " + identity)
            required = {"task_id", "title", "kind", "agent", "dependencies", "base", "assignment_id",
                        "branch", "worktree", "window", "attempt", "state", "summary", "root", "manager_id",
                        "accepted_history", "acceptance_eligibility"}
            if (not required.issubset(item) or not self.namespace.matches(item, identity) or
                    type(item["attempt"]) is not int or item["attempt"] < 0 or
                    not isinstance(item["dependencies"], list) or
                    any(not isinstance(d, str) or d == identity or d not in self.state["tasks"]
                        for d in item["dependencies"]) or
                    item["branch"] != self.namespace.branch(identity) or
                    item["window"] != "mgr-" + identity or
                    item["acceptance_eligibility"] not in ("unaccepted", "reverify_required", "current") or
                    (item["attempt"] == 0 and item["assignment_id"] is not None) or
                    (item["attempt"] > 0 and not self.valid_assignment_id(item["assignment_id"]))):
                raise Error("Invalid persisted task metadata: " + identity)
            if item.get("worktree") != str(self.home / "worktrees" / identity):
                raise Error("Invalid worktree path: " + identity)
            for parent in ("tasks", "inbox", "events", "worktrees"):
                reject_symlinks(self.home / parent / identity)

    def save(self):
        self.state["updated_at"] = now()
        atomic_json(self.state_path, self.state)

    def directory(self, identity):
        return reject_symlinks(self.home / "tasks" / identity)

    def task(self, identity):
        if identity not in self.state["tasks"]:
            raise Error("Unknown task: " + identity)
        return self.state["tasks"][identity]

    def event(self, identity, kind, **details):
        path = self.home / "events" / (identity or "manager")
        atomic_json(path / (uuid.uuid4().hex + ".json"),
                    {**self.namespace.envelope(identity), "type": kind, "at": now(), **details})

    def init(self):
        config(self.root)  # Reject unsupported config before writing project state.
        self.namespace.legacy_check()
        if self.state_path.exists():
            self.load()
            return self.init_result(False)
        if self.home.exists():
            self.load()  # Another initializer may have atomically published since exists() above.
            return self.init_result(False)
        git(self.root, "rev-parse", "--verify", "HEAD")
        exclude = reject_symlinks(self.common / "info" / "exclude")
        old_exclude = exclude.read_text() if exclude.exists() else ""
        self.control.mkdir(exist_ok=True)
        with lock(self.control / "maintenance.lock"):
            self.namespace.legacy_check()
            if self.home.exists():
                self.load()
                return self.init_result(False)
            binding = self.control / "projects" / (self.key + ".json")
            if binding.exists() and read_json(binding).get("root") != str(self.root):
                raise Error("Project key collision; refusing another root's resources")
            old_exclude = exclude.read_text() if exclude.exists() else ""
            container = self.namespace.container
            container.mkdir(exist_ok=True)
            stage = container / (".init-" + uuid.uuid4().hex)
            stage.mkdir()
            for name in ("events", "inbox", "tasks", "worktrees"):
                (stage / name).mkdir()
            self.state = {**self.namespace.envelope(), "version": 2, "project_key": self.key,
                          "git_common_dir": str(self.common), "session": self.session,
                          "created_at": now(), "updated_at": now(), "tasks": {}}
            atomic_json(stage / "state.json", self.state)
            atomic_json(stage / "owner.json", {**self.namespace.envelope(), "version": 1,
                        "generation": 0, "state": "released", "session_id": None,
                        "token_sha256": None, "acquired_at": None,
                        "last_activity_at": None, "released_at": None})
            (stage / ".lock").touch()
            atomic_json(stage / "events" / "manager" / (uuid.uuid4().hex + ".json"),
                        {**self.namespace.envelope(), "type": "manager.initialized", "at": now()})
            atomic_json(binding, {"root": str(self.root), "project_key": self.key})
            if "/.manager/" not in old_exclude.splitlines():
                atomic_text(exclude, old_exclude +
                            ("\n" if old_exclude and not old_exclude.endswith("\n") else "") + "/.manager/\n")
            stage.rename(self.home)
        return self.init_result(True)

    def init_result(self, initialized):
        return {"initialized": initialized, "root": str(self.root), "manager_id": self.manager_id,
                "version": 2, "home": str(self.home), "state": str(self.state_path),
                "owner": self.owner_summary(), "max_workers": config(self.root)["manager"]["max_workers"]}

    @staticmethod
    def valid_assignment_id(value):
        return isinstance(value, str) and re.fullmatch(r"[a-f0-9]{32}", value) is not None

    def owner(self):
        record = read_json(self.home / "owner.json")
        if (type(record.get("version")) is not int or record["version"] != 1
                or not self.namespace.matches(record)
                or type(record.get("generation")) is not int or record["generation"] < 0
                or record.get("state") not in ("active", "released")
                or (record["state"] == "active" and
                    (not isinstance(record.get("session_id"), str) or not record["session_id"].strip()
                     or not isinstance(record.get("token_sha256"), str)
                     or re.fullmatch(r"[a-f0-9]{64}", record["token_sha256"]) is None))
                or (record["state"] == "released" and record.get("token_sha256") is not None)):
            raise Error("Invalid owner identity or metadata; preserve and repair")
        return record

    def owner_summary(self):
        return {k: v for k, v in self.owner().items() if k != "token_sha256"}

    def require_owner(self, filename):
        if not filename:
            raise Error("Management writes require --owner-file; claim this manager explicitly")
        path = Path(filename).expanduser()
        if path.is_symlink():
            raise Error("Refusing symlink owner credential")
        path = path.parent.resolve() / path.name
        if path.stat().st_mode & 0o077:
            raise Error("Owner credential must be private (0600)")
        credential, owner = read_json(path), self.owner()
        token = credential.get("token")
        if (owner["state"] != "active" or not self.namespace.matches(credential)
                or type(credential.get("version")) is not int or credential["version"] != 1
                or type(credential.get("generation")) is not int
                or credential.get("generation") != owner["generation"]
                or not isinstance(token, str) or len(token) != 64
                or not secrets.compare_digest(hashlib.sha256(token.encode()).hexdigest(),
                                              owner["token_sha256"] or "")):
            raise Error("Invalid or fenced owner credential for this manager")
        return owner

    def owner_operations(self):
        directory = reject_symlinks(self.home / "owner-operations")
        if not directory.exists():
            return []
        records = []
        for path in read_directory(directory):
            if path.suffix != ".json":
                continue  # Preserve an interrupted atomic-write temporary without adopting it.
            record = read_json(path)
            if (not self.namespace.matches(record) or record.get("id") != path.stem
                    or not self.valid_assignment_id(record.get("id"))
                    or record.get("action") not in ("claim", "release", "takeover")
                    or record.get("state") not in ("pending", "committed", "not_committed")
                    or not isinstance(record.get("owner"), dict)
                    or not self.namespace.matches(record["owner"])
                    or type(record["owner"].get("generation")) is not int
                    or record["owner"]["generation"] < 1
                    or record["owner"].get("operation_id") != record["id"]
                    or not isinstance(record.get("event"), dict)
                    or not self.namespace.matches(record["event"])
                    or record["event"].get("operation_id") != record["id"]):
                raise Error("Invalid owner operation journal; preserve and diagnose")
            records.append(record)
        return records

    def repair_owner_events(self):
        # Never activate an uncommitted credential. Only repair a proven owner commit.
        owner = self.owner()
        for record in self.owner_operations():
            if record["state"] != "pending":
                continue
            path = self.home / "owner-operations" / (record["id"] + ".json")
            if owner.get("operation_id") == record["id"] and owner == record["owner"]:
                self.owner_event(record)
                record["state"] = "committed"
            else:
                record["state"] = "not_committed"
            atomic_json(path, record)

    def owner_event(self, record):
        path = self.home / "events" / "manager" / (record["id"] + ".json")
        if path.exists():
            if read_json(path) != record["event"]:
                raise Error("Conflicting owner event; preserve and diagnose")
        else:
            atomic_json(path, record["event"])

    def change_owner(self, args):
        action = args.owner_action
        owner = self.owner()
        if action == "release":
            self.require_owner(args.owner_file)
        elif action == "claim" and owner["state"] != "released":
            raise Error("Manager already has an active owner; use explicit takeover for handoff")
        elif action == "takeover":
            if owner["state"] != "active" or owner["generation"] != args.expect_generation:
                raise Error("Takeover requires an active owner at --expect-generation")
            if not args.reason.strip():
                raise Error("Takeover reason must be nonempty")
        if action == "release":
            return self.commit_owner(owner, action)
        if not args.session_id.strip() or len(args.session_id) > 128:
            raise Error("Session ID must be nonempty and at most 128 characters")
        filename = Path(args.credential_file).expanduser()
        if filename.is_symlink():
            raise Error("Refusing symlink owner credential")
        filename = filename.parent.resolve() / filename.name
        reject_symlinks(filename)
        if (self.namespace.container == filename or self.namespace.container in filename.parents
                or self.control == filename or self.control in filename.parents):
            raise Error("Keep owner credentials outside manager and worker artifact directories")
        # Worktrees from other managers share this host: exclude every registered tree too.
        for tree in self.worktrees():
            if str(filename) == tree or tree in (str(p) for p in filename.parents):
                # Credentials in the main project outside .manager are allowed; private worker trees are not.
                if tree != str(self.root):
                    raise Error("Keep owner credentials outside worker worktrees")
        if filename.exists():
            raise Error("Credential file already exists; never overwrite or reuse an uncommitted credential")
        token = secrets.token_hex(32)
        generation = owner["generation"] + 1
        credential = {**self.namespace.envelope(), "version": 1,
                      "generation": generation, "token": token}
        proposed = {**owner, "generation": generation, "state": "active", "session_id": args.session_id,
                    "token_sha256": hashlib.sha256(token.encode()).hexdigest(), "acquired_at": now(),
                    "last_activity_at": now(), "released_at": None}
        record = self.owner_intent(proposed, action, credential_file=str(filename),
                                   reason=getattr(args, "reason", None))
        fd = os.open(filename, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, "w") as stream:
            stream.write(json.dumps(credential) + "\n")
            stream.flush()
            os.fsync(stream.fileno())
        sync_directory(filename.parent)
        self.publish_owner(record)
        return {**self.owner_summary(), "credential_file": str(filename)}

    def owner_intent(self, proposed, action, **details):
        identity = uuid.uuid4().hex
        proposed["operation_id"] = identity
        event = {**self.namespace.envelope(), "type": "owner." +
                 {"claim": "claimed", "release": "released", "takeover": "taken_over"}[action],
                 "at": now(), "operation_id": identity, "generation": proposed["generation"],
                 "session_id": proposed["session_id"], **details}
        record = {**self.namespace.envelope(), "id": identity, "action": action, "state": "pending",
                  "owner": proposed, "event": event}
        atomic_json(self.home / "owner-operations" / (identity + ".json"), record)
        return record

    def publish_owner(self, record):
        atomic_json(self.home / "owner.json", record["owner"])
        self.owner_event(record)
        record["state"] = "committed"
        atomic_json(self.home / "owner-operations" / (record["id"] + ".json"), record)

    def commit_owner(self, owner, action):
        proposed = {**owner, "generation": owner["generation"] + 1, "state": "released",
                    "token_sha256": None, "released_at": now(), "last_activity_at": now()}
        self.publish_owner(self.owner_intent(proposed, action))
        return self.owner_summary()

    def touch_owner(self, filename):
        owner = self.require_owner(filename)
        owner["last_activity_at"] = now()
        atomic_json(self.home / "owner.json", owner)

    def register(self, args):
        if args.id in self.state["tasks"]:
            raise Error("Task already exists; spawn it by ID or retry it")
        if not args.title or not args.brief:
            raise Error("New tasks require --title and --brief")
        brief = Path(args.brief).resolve().read_text()
        if not brief.strip():
            raise Error("Task brief must not be empty")
        dependencies = args.depends_on or []
        if len(set(dependencies)) != len(dependencies):
            raise Error("Duplicate dependencies")
        for identity in dependencies:
            self.task(identity)
        base = git(self.root, "rev-parse", "--verify", "--end-of-options", args.base + "^{commit}")
        item = {**self.namespace.envelope(args.id), "title": args.title, "kind": args.kind,
                "agent": args.agent, "dependencies": dependencies, "base": base,
                "branch": self.namespace.branch(args.id),
                "worktree": str(self.home / "worktrees" / args.id),
                "window": "mgr-" + args.id, "pane": None, "attempt": 0,
                "state": "queued", "summary": "Queued", "created_at": now(),
                "assignment_id": None, "verification": None, "accepted": None,
                "accepted_history": None, "acceptance_eligibility": "unaccepted", "report_error": None}
        directory = self.directory(args.id)
        if directory.exists():
            raise Error("Unregistered task artifacts exist; preserve and inspect them")
        directory.mkdir()
        (directory / ".operation.lock").touch()
        (self.home / "inbox" / args.id).mkdir()
        (self.home / "events" / args.id).mkdir()
        atomic_text(directory / "brief.md", brief)
        atomic_json(directory / "status.json", self.initial_report(item, "queued"))
        self.state["tasks"][args.id] = item
        self.save()
        self.event(args.id, "task.queued")
        return item

    def initial_report(self, item, state):
        return {**self.namespace.envelope(item["task_id"]), "attempt": item["attempt"],
                "assignment_id": item["assignment_id"], "state": state,
                "summary": item["summary"], "question": None, "updated_at": now(), "acks": []}

    def panes(self):
        result = run(["tmux", "list-panes", "-s", "-t", self.session,
                      "-F", "#{window_name}\t#{pane_id}\t#{pane_dead}"], check=False)
        if result.returncode:
            # No server/session is normal. Other tmux failures must not erase live state.
            error = result.stderr.decode(errors="replace")
            if any(x in error for x in ("no server running", "no sessions", "can't find",
                                         "No such file or directory")):
                return {}
            raise Error("tmux inventory failed: " + error.strip())
        for option, expected in (("@manager_root", str(self.root)), ("@manager_id", self.manager_id)):
            value = run(["tmux", "show-options", "-qv", "-t", self.session, option]).stdout.decode().strip()
            if value != expected:
                raise Error("tmux session identity mismatch; refusing to inspect or control another session")
        inventory = {}
        for line in result.stdout.decode().splitlines():
            window, pane, dead = line.split("\t")
            if window in inventory:
                raise Error("Ambiguous worker window: " + window)
            inventory[window] = {"id": pane, "dead": dead == "1"}
        return inventory

    def worktrees(self):
        result = run(["git", "-C", self.root, "worktree", "list", "--porcelain", "-z"])
        records, current = {}, None
        for field in result.stdout.decode(errors="surrogateescape").split("\0"):
            if field.startswith("worktree "):
                current = str(Path(field[9:]).resolve())
                records[current] = {}
            elif current and field.startswith("branch "):
                records[current]["branch"] = field[7:]
        return records

    def reconcile(self, persist=True):
        settings = config(self.root)
        inventory, worktrees = self.panes(), self.worktrees()
        notices = []
        for identity, item in self.state["tasks"].items():
            if persist and identity in self.busy_tasks:
                notices.append({"task_id": identity, "issue": "operation_busy"})
                continue
            intent_path = self.directory(identity) / "accept-intent.json"
            if intent_path.exists():
                intent = read_json(intent_path)
                if (self.namespace.matches(intent, identity) and intent.get("state") == "pending"
                        and intent.get("attempt") == item["attempt"]
                        and intent.get("assignment_id") == item["assignment_id"]):
                    notices.append({"task_id": identity, "issue": "accept_intent_needs_diagnosis"})
            previous = (item["state"], item["summary"], item.get("report_error"))
            report = None
            try:
                report = read_json(self.directory(identity) / "status.json")
                if (not self.namespace.matches(report, identity) or type(report.get("attempt")) is not int
                        or report.get("attempt") != item["attempt"]
                        or report.get("assignment_id") != item["assignment_id"]
                        or report.get("state") not in WORKER_STATES | {"queued"} or
                        not isinstance(report.get("summary"), str)):
                    raise Error("Invalid report identity, attempt, state, or summary")
                if report["state"] == "done":
                    result_path = reject_symlinks(self.directory(identity) / "result.md")
                    if not result_path.is_file() or not result_path.read_text().strip():
                        raise Error("Worker completion has no nonempty result.md")
                if report["state"] == "needs_manager" and (
                        not isinstance(report.get("question"), dict) or
                        not isinstance(report["question"].get("text"), str) or
                        not report["question"]["text"].strip()):
                    raise Error("Worker question is missing or invalid")
                stamp = dt.datetime.fromisoformat(report["updated_at"])
                age = (dt.datetime.now(dt.timezone.utc) - stamp).total_seconds()
                item["report_error"] = None
                item["worker_state"] = report["state"]
                item["question"] = report.get("question")
                item["stale"] = age > settings["manager"]["stale_seconds"]
            except (Error, OSError, KeyError, TypeError, ValueError) as exc:
                item["report_error"] = str(exc)
                item["verification"] = None
                if item["state"] not in ("done", "cancelled"):
                    item["state"] = "failed"
                    item["summary"] = "Invalid worker report; inspect preserved artifacts"
            pane = inventory.get(item["window"])
            item["pane"] = pane["id"] if pane else None
            item["alive"] = bool(pane and not pane["dead"])
            record = worktrees.get(item["worktree"])
            item["worktree_valid"] = bool(record and record.get("branch") ==
                                           "refs/heads/" + item["branch"] and
                                           Path(item["worktree"]).is_dir())
            terminal = item["state"] in ("done", "cancelled", "failed")
            if not terminal and not item["report_error"] and item["state"] != "queued":
                if not item["worktree_valid"]:
                    item["state"], item["summary"] = "failed", "Worktree missing or branch changed"
                    item["verification"] = None
                elif report["state"] == "done":
                    item["state"], item["summary"] = "verification", report["summary"]
                elif not item["alive"]:
                    item["state"], item["summary"] = "failed", "Worker missing or exited before completion"
                    item["verification"] = None
                elif item["state"] != "needs_user":
                    item["state"], item["summary"] = report["state"], report["summary"]
            if item.get("stale") and item["state"] not in ("done", "cancelled", "queued"):
                notices.append({"task_id": identity, "issue": "stale_report"})
            if persist and previous != (item["state"], item["summary"], item.get("report_error")):
                self.event(identity, "task.reconciled", state=item["state"], summary=item["summary"])
        known = {x["window"] for x in self.state["tasks"].values()}
        orphans = {name: pane for name, pane in inventory.items()
                   if name.startswith("mgr-") and name not in known}
        known_trees = {x["worktree"] for x in self.state["tasks"].values()}
        orphan_trees = [str(p) for p in read_directory(self.home / "worktrees")
                        if str(p) not in known_trees]
        orphan_tasks = [str(p) for p in read_directory(self.home / "tasks")
                        if p.is_dir() and p.name not in self.state["tasks"]]
        if persist:
            self.save()
        active = sum(not p["dead"] for name, p in inventory.items() if name.startswith("mgr-"))
        return {"root": str(self.root), "manager_id": self.manager_id,
                "tasks": list(self.state["tasks"].values()), "notices": notices,
                "worker_capacity": {"active": active, "max_workers": settings["manager"]["max_workers"],
                                    "scope": "manager"},
                "orphan_panes": orphans, "orphan_worktrees": orphan_trees,
                "orphan_tasks": orphan_tasks}

    def recover_operations(self):
        # Called only with the corresponding operation locks and registry lock.
        for identity, item in self.state["tasks"].items():
            if identity in self.busy_tasks:
                continue
            operation = item.get("operation")
            if not operation or operation.get("state") != "running":
                continue
            if (not self.namespace.matches(operation, identity)
                    or not self.valid_assignment_id(operation.get("id"))
                    or operation.get("action") != "verify"):
                raise Error("Invalid pending operation; preserve and diagnose")
            evidence = self.directory(identity) / "verification" / operation["id"]
            journal = read_json(evidence / "operation.json")
            if journal.get("id") != operation["id"] or not self.namespace.matches(journal, identity):
                raise Error("Pending verification journal mismatch; preserve and diagnose")
            # The lock proves the old runtime released the resource, not that its
            # children or arbitrary host writes stopped. Never infer check success.
            diagnostic = {**journal, "state": "interrupted", "recovered_at": now(),
                          "snapshot_matches": None, "diagnostic_error": None}
            if journal.get("state") in ("fenced", "snapshot_changed", "failed", "passed"):
                diagnostic["state"] = journal["state"]
            try:
                diagnostic["snapshot_matches"] = (
                    self.fingerprint(item) == journal["fingerprint"] and
                    hashlib.sha256(read_bytes(evidence / "review.md")).hexdigest() == journal["review_sha256"])
            except (Error, OSError, KeyError, ValueError) as exc:
                diagnostic["diagnostic_error"] = str(exc)
            atomic_json(evidence / "operation.json", diagnostic)
            item["operation"] = diagnostic
            item["verification"] = None
            self.save()
            self.event(identity, "manager.operation_interrupted", operation_id=operation["id"])

    def launch(self, item, agent_override=None):
        self.reconcile()
        if item["state"] != "queued":
            raise Error("spawn requires a queued task; use retry for failed work")
        for identity in item["dependencies"]:
            if (self.task(identity)["state"] != "done" or
                    self.task(identity)["acceptance_eligibility"] != "current"):
                raise Error("Dependency is not manager-accepted: " + identity)
            self.source_snapshot(identity)
        settings = config(self.root)
        active = sum(not p["dead"] for name, p in self.panes().items() if name.startswith("mgr-"))
        if active >= settings["manager"]["max_workers"]:
            raise Error("max_workers reached; stop an idle worker first")
        preference = agent_override or item["agent"]
        if preference == "auto":
            preference = settings["agents"].get(item["kind"], settings["agents"]["default"])
        try:
            name, executable = adapter.resolve(preference)
        except ValueError as exc:
            raise Error(str(exc)) from exc
        # Check tmux before creating branches/worktrees.
        run(["tmux", "-V"])
        tree = reject_symlinks(Path(item["worktree"]))
        if not tree.exists():
            exists = run(["git", "-C", self.root, "show-ref", "--verify", "--quiet",
                          "refs/heads/" + item["branch"]], check=False).returncode == 0
            if exists:
                raise Error("Task branch already exists without its worktree; inspect before recovery")
            git(self.root, "worktree", "add", "-b", item["branch"], str(tree), item["base"])
        elif not item.get("worktree_valid"):
            raise Error("Worktree registration or branch does not match the task")
        directory = self.directory(item["task_id"])
        reject_symlinks(directory / "log.txt")
        item["attempt"] += 1
        item["assignment_id"] = uuid.uuid4().hex
        item.update(state="working", summary="Worker starting", agent=name,
                    verification=None, accepted=None, report_error=None)
        assignment = {**self.namespace.envelope(item["task_id"]), "version": 2,
                      "attempt": item["attempt"], "assignment_id": item["assignment_id"],
                      "reporting_enabled": True, "worktree": str(tree), "runtime": str(HERE),
                      "auto_commit": settings["git"]["auto_commit"]}
        with lock(directory / ".report.lock"):
            atomic_json(directory / "assignment.json", assignment)
            atomic_json(directory / "status.json", self.initial_report(item, "working"))
        prompt = ("You are a worker managed by a primary agent, not a manager. Do not launch subagents. "
                  "Read repository instructions and these files before working: " + str(directory / "brief.md") +
                  "; " + str(directory / "assignment.json") + "; " + str(SKILL / "references/worker-protocol.md") +
                  ". Work only in " + str(tree) + ". Use the absolute runtime " + str(HERE) +
                  " with --root " + shlex.quote(str(self.root)) + " --manager-id " + self.manager_id +
                  " report " + item["task_id"] + " --attempt " + str(item["attempt"]) +
                  " --assignment-id " + item["assignment_id"] + " to report status. Read your inbox and prior result "
                  "if present. Ask the manager through needs_manager; never bypass native permissions. "
                  "Write result.md before reporting done; manager acceptance is independent. " +
                  ("Commit only task-owned changes if repository/user policy permits."
                   if settings["git"]["auto_commit"] else "Do not commit unless the manager instructs you."))
        writable = [directory, self.home / "events" / item["task_id"],
                    self.home / "inbox" / item["task_id"]]
        argv = adapter.command(name, executable, tree, writable, prompt)
        env = ["env", "-u", "MANAGER_OWNER_FILE", "MANAGER_WORKER_ROOT=" + str(self.root),
               "MANAGER_WORKER_MANAGER=" + self.manager_id, "MANAGER_WORKER_TASK=" + item["task_id"],
               "MANAGER_WORKER_ATTEMPT=" + str(item["attempt"]),
               "MANAGER_WORKER_ASSIGNMENT=" + item["assignment_id"]]
        self.save()  # Persist intent before starting a process.
        self.event(item["task_id"], "worker.starting", attempt=item["attempt"], agent=name)
        try:
            if run(["tmux", "has-session", "-t", self.session], check=False).returncode:
                run(["tmux", "new-session", "-d", "-s", self.session, "-n", "control", "-c", self.root])
                run(["tmux", "set-option", "-t", self.session, "@manager_root", str(self.root)])
                run(["tmux", "set-option", "-t", self.session, "@manager_id", self.manager_id])
            else:
                self.panes()  # Refuse existing sessions without matching metadata.
            # Set remain-on-exit before launch so immediate CLI errors remain inspectable.
            run(["tmux", "set-option", "-t", self.session, "remain-on-exit", "on"])
            pane = run(["tmux", "new-window", "-d", "-t", self.session + ":", "-n", item["window"],
                        "-c", tree, "-P", "-F", "#{pane_id}", "exec " + shlex.join(env + argv)]).stdout.decode().strip()
            item["pane"] = pane
            self.save()
            run(["tmux", "pipe-pane", "-o", "-t", pane,
                 "cat >> " + shlex.quote(str(directory / "log.txt"))])
        except Error as exc:
            item.update(state="failed", summary="Launch failed: " + str(exc))
            self.save()
            self.event(item["task_id"], "worker.launch_failed", error=str(exc))
            raise
        self.event(item["task_id"], "worker.spawned", attempt=item["attempt"], pane=pane)
        return item

    def report(self, args):
        directory = self.directory(args.id)
        with lock(directory / ".report.lock"):
            assignment = self.assignment(args.id)
            if (assignment["attempt"] != args.attempt or
                    assignment["assignment_id"] != args.assignment_id):
                raise Error("Stale or invalid attempt; read assignment.json")
            if (directory / "accepted.json").exists() or (directory / "stopped.json").exists():
                raise Error("Task is accepted or stopped; no more worker reports allowed")
            old = read_json(directory / "status.json")
            if (not self.namespace.matches(old, args.id) or old.get("attempt") != assignment["attempt"]
                    or old.get("assignment_id") != assignment["assignment_id"]):
                raise Error("Invalid current report identity; preserve and diagnose")
            if args.state == "needs_manager" and not args.question:
                raise Error("needs_manager requires --question")
            if args.state == "done":
                path = reject_symlinks(directory / "result.md")
                if not path.is_file() or not path.read_text().strip():
                    raise Error("done requires nonempty result.md")
            acks = set(old.get("acks", []))
            for message in args.ack:
                if not re.fullmatch(r"[a-f0-9]{32}", message) or not (self.home / "inbox" / args.id / (message + ".json")).is_file():
                    raise Error("Unknown inbox message: " + message)
                record = read_json(self.home / "inbox" / args.id / (message + ".json"))
                if (not self.namespace.matches(record, args.id) or record.get("message_id") != message
                        or record.get("attempt") != args.attempt
                        or record.get("assignment_id") != args.assignment_id):
                    raise Error("Inbox message belongs to another manager, task or attempt")
                acks.add(message)
            value = {**self.namespace.envelope(args.id), "attempt": args.attempt,
                     "assignment_id": args.assignment_id, "state": args.state,
                     "summary": args.summary, "question": None, "updated_at": now(), "acks": sorted(acks)}
            if args.question:
                value["question"] = {"type": args.question_type, "text": args.question, "options": args.option}
            if args.file:
                value["files_changed"] = args.file
            if bool(args.test_command) != bool(args.test_result):
                raise Error("--test-command and --test-result must be supplied together")
            if args.test_command:
                value["tests"] = {"command": args.test_command, "result": args.test_result}
            atomic_json(directory / "status.json", value)
            self.event(args.id, "worker." + args.state, attempt=args.attempt)
            return value

    def assignment(self, identity):
        record = read_json(self.directory(identity) / "assignment.json")
        if (type(record.get("version")) is not int or record["version"] != 2
                or not self.namespace.matches(record, identity)
                or type(record.get("attempt")) is not int or record["attempt"] < 1
                or not self.valid_assignment_id(record.get("assignment_id"))
                or record.get("reporting_enabled") is not True
                or record.get("worktree") != str(self.home / "worktrees" / identity)):
            raise Error("Invalid, migrated or revoked worker assignment")
        return record

    def inbox(self, identity):
        directory = self.directory(identity)
        report = read_json(directory / "status.json")
        if not self.namespace.matches(report, identity):
            raise Error("Invalid inbox report identity")
        acks = set(report.get("acks", []))
        messages = [read_json(p) for p in read_directory(self.home / "inbox" / identity)
                    if p.suffix == ".json"]
        result = []
        for message in messages:
            if (not self.namespace.matches(message, identity)
                    or not self.valid_assignment_id(message.get("assignment_id"))
                    or not self.valid_assignment_id(message.get("message_id"))
                    or type(message.get("attempt")) is not int or message["attempt"] < 1):
                raise Error("Invalid inbox message identity")
            current = (message["attempt"] == report.get("attempt") and
                       message["assignment_id"] == report.get("assignment_id"))
            history_acks = set()
            if not current:
                history = directory / "history" / ("attempt-" + str(message["attempt"])) / "status.json"
                if history.exists():
                    previous = read_json(history)
                    if (self.namespace.matches(previous, identity) and
                            previous.get("assignment_id") == message["assignment_id"]):
                        history_acks = set(previous.get("acks", []))
            result.append({**message, "current_attempt": current,
                           "acknowledged": message["message_id"] in (acks if current else history_acks)})
        return result

    def send(self, args):
        self.reconcile()
        item = self.task(args.id)
        if item["state"] in ("done", "cancelled", "queued"):
            raise Error("Cannot send to an accepted, cancelled, or unstarted task")
        message = args.message if args.message is not None else Path(args.message_file).read_text()
        if not message.strip():
            raise Error("Message must not be empty")
        identity = uuid.uuid4().hex
        path = self.home / "inbox" / args.id / (identity + ".json")
        value = {**self.namespace.envelope(args.id), "message_id": identity, "at": now(),
                 "attempt": item["attempt"], "assignment_id": item["assignment_id"],
                 "text": message, "delivery": "inbox"}
        atomic_json(path, value)  # Always save before attempting terminal delivery.
        item["verification"] = None
        if item["state"] != "failed" or (item.get("alive") and item.get("worktree_valid")
                                          and not item.get("report_error")):
            item.update(state="working", summary="Manager sent a message; awaiting worker acknowledgment")
        # Reset a completed/blocked report so stale completion cannot immediately reappear.
        directory = self.directory(args.id)
        with lock(directory / ".report.lock"):
            report = read_json(directory / "status.json")
            report.update(state="working", summary=item["summary"], question=None, updated_at=now())
            atomic_json(directory / "status.json", report)
        self.save()
        delivery_error = None
        if not args.inbox_only and item.get("alive"):
            buffer = "manager-" + identity
            try:
                text = "Manager message " + identity + ": " + message + "\nRead and acknowledge this inbox message."
                run(["tmux", "load-buffer", "-b", buffer, "-"], data=text.encode())
                run(["tmux", "paste-buffer", "-p", "-d", "-b", buffer, "-t", item["pane"]])
                run(["tmux", "send-keys", "-t", item["pane"], "Enter"])
                value["delivery"] = "pasted_unacknowledged"
            except Error as exc:
                delivery_error = str(exc)
                run(["tmux", "delete-buffer", "-b", buffer], check=False)
        elif not args.inbox_only:
            delivery_error = "Worker is not live; message retained in inbox for retry"
        value["delivery_error"] = delivery_error
        atomic_json(path, value)
        self.event(args.id, "manager.message", message_id=identity, delivery=value["delivery"])
        return {**value, "delivery_error": delivery_error}

    def kill(self, item):
        pane = self.panes().get(item["window"])
        if pane:
            if item.get("pane") and item["pane"] != pane["id"]:
                raise Error("Pane identity changed; inspect before stopping")
            run(["tmux", "kill-pane", "-t", pane["id"]])
        item["pane"], item["alive"] = None, False

    def stop(self, args):
        item = self.task(args.id)
        directory = self.directory(args.id)
        self.panes()  # Diagnose ownership before publishing any stop marker.
        with lock(directory / ".report.lock"):
            atomic_json(directory / "stopped.json", {**self.namespace.envelope(args.id),
                        "at": now(), "attempt": item["attempt"], "assignment_id": item["assignment_id"]})
            self.kill(item)
            if item["state"] != "done":
                item.update(state="cancelled", summary="Stopped by manager", verification=None)
                previous = read_json(directory / "status.json")
                report = self.initial_report(item, "cancelled")
                if self.namespace.matches(previous, args.id):
                    report["acks"] = previous.get("acks", [])
                atomic_json(directory / "status.json", report)
        self.save()
        self.event(args.id, "worker.stopped")
        return item

    def retry(self, args):
        self.reconcile()
        item = self.task(args.id)
        if item["state"] not in ("failed", "cancelled"):
            raise Error("retry requires failed or cancelled state; send corrections to a live worker")
        if item["attempt"] >= 1 + config(self.root)["manager"]["max_retries"]:
            raise Error("Retry limit reached; diagnose and report the remaining blocker")
        if not item.get("worktree_valid"):
            raise Error("Cannot retry missing or mismatched worktree; preserve and repair first")
        self.event(args.id, "worker.retry_intent", attempt=item["attempt"],
                   assignment_id=item["assignment_id"])
        self.kill(item)
        directory = self.directory(args.id)
        with lock(directory / ".report.lock"):
            previous = read_json(directory / "status.json")
            atomic_json(directory / "history" / ("attempt-" + str(item["attempt"])) / "status.json", previous)
            for filename in ("stopped.json", "accepted.json"):
                marker = directory / filename
                if marker.exists():
                    marker.unlink()
            item.update(state="queued", summary="Retry queued", verification=None)
            atomic_json(directory / "status.json", self.initial_report(item, "queued"))
        self.save()
        return self.launch(item, args.agent)

    def fingerprint(self, item):
        tree = Path(item["worktree"])
        if not item.get("worktree_valid"):
            raise Error("Cannot verify missing or mismatched worktree")
        digest = hashlib.sha256()
        for argv in (["rev-parse", "HEAD"], ["diff", "--binary", "HEAD", "--"],
                     ["diff", "--binary", "--cached", "HEAD", "--"],
                     ["status", "--porcelain=v1", "-z"]):
            digest.update(run(["git", "-C", tree, *argv]).stdout)
        files = run(["git", "-C", tree, "ls-files", "--others", "--exclude-standard", "-z"]).stdout
        for filename in sorted(x for x in files.split(b"\0") if x):
            path = tree / os.fsdecode(filename)
            digest.update(filename + b"\0")
            if path.is_symlink():
                digest.update(os.fsencode(os.readlink(path)))
            else:
                digest.update(str(path.stat().st_mode).encode())
                with path.open("rb") as stream:
                    for chunk in iter(lambda: stream.read(1024 * 1024), b""):
                        digest.update(chunk)
        for filename in ("status.json", "result.md"):
            path = reject_symlinks(self.directory(item["task_id"]) / filename)
            digest.update(read_bytes(path) if path.exists() else b"missing")
        return digest.hexdigest()

    def verify(self, args):
        directory = self.directory(args.id)
        with lock(self.home / ".lock"):
            self.load()
            self.busy_tasks.update(set(self.state["tasks"]) - {args.id})
            owner = self.require_owner(args.owner_file)
            self.repair_owner_events()
            self.recover_operations()
            self.reconcile()
            item = self.task(args.id)
            if (item["state"] != "verification" or item.get("worker_state") != "done"
                    or item.get("report_error")):
                raise Error("verify requires a valid worker completion report")
            review = Path(args.review).read_text()
            if not review.strip():
                raise Error("Independent manager review must not be empty")
            commands = args.command or list(config(self.root)["verification"].values())
            if not commands or any(not c.strip() for c in commands):
                raise Error("Specify independent verification commands or review .manager.yml verification settings")
            identity = uuid.uuid4().hex
            evidence = directory / "verification" / identity
            evidence.mkdir(parents=True)
            atomic_text(evidence / "review.md", review)
            with lock(directory / ".report.lock"):
                assignment = self.assignment(args.id)
                completion = read_json(directory / "status.json")
                result = reject_symlinks(directory / "result.md")
                if (not self.namespace.matches(completion, args.id)
                        or completion.get("attempt") != item["attempt"]
                        or completion.get("assignment_id") != item["assignment_id"]
                        or completion.get("state") != "done"
                        or not result.is_file() or not result.read_text().strip()):
                    raise Error("Completion changed before verification snapshot; reconcile and retry")
                before = self.fingerprint(item)
            review_hash = hashlib.sha256(review.encode()).hexdigest()
            operation = {**self.namespace.envelope(args.id), "id": identity, "action": "verify",
                         "state": "running", "generation": owner["generation"], "pid": os.getpid(),
                         "started_at": now(), "attempt": item["attempt"],
                         "assignment_id": item["assignment_id"], "fingerprint": before,
                         "review_sha256": review_hash}
            atomic_json(evidence / "operation.json", operation)
            item.update(verification=None, operation=operation)
            self.save()
            self.touch_owner(args.owner_file)
        checks, execution_error = run_checks(evidence, item["worktree"], commands, args.timeout, self.home)
        with lock(self.home / ".lock"):
            self.load()  # Never write the start-time registry over another task's work.
            current = self.task(args.id)
            fenced = False
            try:
                final_owner = self.require_owner(args.owner_file)
                fenced = final_owner["generation"] != owner["generation"]
            except (Error, OSError, ValueError):
                fenced = True
            diagnostic_error = execution_error
            after = None
            with lock(directory / ".report.lock"):
                try:
                    trees = self.worktrees()
                    current["worktree_valid"] = bool(
                        trees.get(current["worktree"], {}).get("branch") == "refs/heads/" + current["branch"]
                        and Path(current["worktree"]).is_dir())
                    after = self.fingerprint(current)
                    unchanged = (before == after and self.assignment(args.id) == assignment and
                                 current["attempt"] == operation["attempt"] and
                                 current["assignment_id"] == operation["assignment_id"] and
                                 (current.get("operation") or {}).get("id") == identity and
                                 read_json(evidence / "operation.json") == operation and
                                 hashlib.sha256(read_bytes(evidence / "review.md")).hexdigest() == review_hash)
                except (Error, OSError, ValueError) as exc:
                    diagnostic_error = str(exc)
                    unchanged = False
                passed = not fenced and unchanged and not diagnostic_error and all(c["exit_code"] == 0 for c in checks)
                outcome = ("fenced" if fenced else "snapshot_changed" if not unchanged else
                           "passed" if passed else "failed")
                record = {**self.namespace.envelope(args.id), "id": identity, "at": now(),
                          "generation": owner["generation"], "attempt": operation["attempt"],
                          "assignment_id": operation["assignment_id"], "passed": passed,
                          "outcome": outcome, "unchanged": unchanged, "fingerprint": after,
                          "review": str((evidence / "review.md").relative_to(self.home)),
                          "review_sha256": review_hash, "checks": checks, "diagnostic_error": diagnostic_error}
                atomic_json(evidence / "record.json", record)
                finished = {**operation, "state": outcome, "finished_at": now()}
                atomic_json(evidence / "operation.json", finished)
                # Fenced runs may save their diagnostic journal only, never registry eligibility.
                if not fenced and (current.get("operation") or {}).get("id") == identity:
                    current["operation"] = finished
                    current["verification"] = record if unchanged else None
                    current["summary"] = "Independent verification passed" if passed else "Independent verification failed"
                    self.save()
                    self.touch_owner(args.owner_file)
                self.event(args.id, "manager.verified", passed=passed, outcome=outcome, evidence=identity)
            return record

    def accept(self, args):
        self.reconcile()
        item = self.task(args.id)
        record = item.get("verification")
        if (item["state"] != "verification" or not record or not record.get("passed")
                or not self.namespace.matches(record, args.id)
                or not self.valid_assignment_id(record.get("id"))
                or record.get("assignment_id") != item["assignment_id"]
                or record.get("review") != "tasks/" + args.id + "/verification/" + record["id"] + "/review.md"):
            raise Error("accept requires successful independent verification")
        review = reject_symlinks(self.home / record["review"])
        directory = self.directory(args.id)
        with lock(directory / ".report.lock"):
            if (record["attempt"] != item["attempt"] or
                    record["fingerprint"] != self.fingerprint(item) or
                    hashlib.sha256(review.read_bytes()).hexdigest() != record["review_sha256"]):
                item["verification"] = None
                self.save()
                raise Error("Worktree/report/review changed since verification; verify again")
            # End the session before acceptance, then recheck for shutdown-time changes.
            atomic_json(directory / "accept-intent.json", {**self.namespace.envelope(args.id),
                        "state": "pending", "at": now(), "attempt": item["attempt"],
                        "assignment_id": item["assignment_id"], "verification_id": record["id"],
                        "fingerprint": record["fingerprint"]})
            self.kill(item)
            if record["fingerprint"] != self.fingerprint(item):
                item["verification"] = None
                self.save()
                raise Error("Worker changed files while stopping; review and verify again")
            item.update(state="done", summary="Manager accepted isolated result", accepted=now(),
                        acceptance_eligibility="current")
            atomic_json(directory / "accepted.json", {**self.namespace.envelope(args.id),
                        "attempt": item["attempt"], "assignment_id": item["assignment_id"],
                        "at": item["accepted"], "verification_id": record["id"]})
        self.save()
        self.event(args.id, "task.accepted", verification_id=record["id"])
        intent = read_json(directory / "accept-intent.json")
        atomic_json(directory / "accept-intent.json", {**intent, "state": "committed"})
        return item

    def integration_record(self):
        path = reject_symlinks(self.home / "integration.json")
        record = read_json(path)
        if (record.get("version") != 1 or type(record.get("version")) is not int
                or not self.namespace.matches(record) or record.get("resource") != "integration"
                or record.get("state") not in ("initializing", "ready")
                or record.get("branch") != self.namespace.integration_branch
                or record.get("worktree") != str(self.home / "integration")
                or not self.valid_assignment_id(record.get("creation_id"))
                or not isinstance(record.get("base"), str)
                or not re.fullmatch(r"[a-f0-9]{40}|[a-f0-9]{64}", record["base"])
                or (record.get("verification") is not None and
                    not self.valid_assignment_id(record["verification"]))
                or (record.get("operation") is not None and not isinstance(record["operation"], dict))):
            raise Error("Invalid integration identity or metadata; preserve and diagnose")
        if (not isinstance(record.get("verifications"), dict) or
                any(not self.valid_assignment_id(k) or not isinstance(v, str) or
                    not re.fullmatch(r"[a-f0-9]{64}", v) for k, v in record["verifications"].items())):
            raise Error("Invalid combined verification index; preserve and diagnose")
        reject_symlinks(Path(record["worktree"]))
        reject_symlinks(self.home / "integration-verification")
        return record

    def direct_commit(self, ref):
        if run(["git", "-C", self.root, "symbolic-ref", "-q", ref], check=False).returncode == 0:
            raise Error("Symbolic refs are not supported: " + ref)
        oid = git(self.root, "show-ref", "--verify", "--hash", ref)
        if git(self.root, "cat-file", "-t", oid) != "commit":
            raise Error("Ref must point directly to a commit: " + ref)
        return oid

    def integration_identity(self, record):
        tree = Path(record["worktree"])
        registration = self.worktrees().get(str(tree))
        if (not tree.is_dir() or not registration or
                registration.get("branch") != "refs/heads/" + record["branch"]):
            raise Error("Integration worktree registration/branch mismatch; preserve and diagnose")
        if (Path(git(tree, "rev-parse", "--show-toplevel")).resolve() != tree or
                git(tree, "symbolic-ref", "-q", "HEAD") != "refs/heads/" + record["branch"]):
            raise Error("Integration checkout identity mismatch")
        common = Path(git(tree, "rev-parse", "--git-common-dir"))
        if (common if common.is_absolute() else tree / common).resolve() != self.common:
            raise Error("Integration worktree belongs to another repository")
        return self.direct_commit("refs/heads/" + record["branch"])

    def integration_init(self, args):
        with lock(self.home / ".lock"):
            self.load()
            self.require_owner(args.owner_file)
            self.repair_owner_events()
            base = git(self.root, "rev-parse", "--verify", "--end-of-options", args.base + "^{commit}")
            path = reject_symlinks(self.home / "integration.json")
            tree = reject_symlinks(self.home / "integration")
            ref = "refs/heads/" + self.namespace.integration_branch
            if path.exists():
                record = self.integration_record()
                if record["base"] != base:
                    raise Error("Integration already has a different base; never reset it")
                if record["state"] == "ready":
                    self.integration_identity(record)
                    return {**record, "initialized": False}
            else:
                if tree.exists() or run(["git", "-C", self.root, "show-ref", "--verify", "--quiet", ref], check=False).returncode == 0:
                    raise Error("Unregistered integration artifacts/ref exist; preserve and diagnose")
                record = {**self.namespace.envelope(), "version": 1, "resource": "integration",
                          "state": "initializing", "branch": self.namespace.integration_branch,
                          "worktree": str(tree), "base": base, "created_at": now(),
                          "creation_id": uuid.uuid4().hex, "verification": None, "operation": None,
                          "verifications": {}}
                atomic_json(path, record)  # Durable intent before shared Git metadata changes.
            registrations = self.worktrees()
            if str(tree) not in registrations:
                if tree.exists() or run(["git", "-C", self.root, "show-ref", "--verify", "--quiet", ref], check=False).returncode == 0:
                    raise Error("Partial integration creation is ambiguous; inspect preserved intent/ref/tree")
                git(self.root, "worktree", "add", "-b", record["branch"], str(tree), base)
            if self.integration_identity(record) != base or git(tree, "status", "--porcelain=v1", "--untracked-files=all"):
                raise Error("Interrupted integration initialization changed; preserve and diagnose")
            record["state"] = "ready"
            atomic_json(path, record)
            self.touch_owner(args.owner_file)
            self.event(None, "integration.initialized", creation_id=record["creation_id"], base=base)
            return {**record, "initialized": True}

    def candidate_snapshot(self, record):
        if record["state"] != "ready":
            raise Error("Integration initialization pending; resume integration init with its recorded base")
        head = self.integration_identity(record)
        tree = Path(record["worktree"])
        for marker in ("MERGE_HEAD", "CHERRY_PICK_HEAD", "REVERT_HEAD", "REBASE_HEAD",
                       "rebase-merge", "rebase-apply", "sequencer", "BISECT_LOG"):
            path = Path(git(tree, "rev-parse", "--git-path", marker))
            if (path if path.is_absolute() else tree / path).exists():
                raise Error("Integration has an in-progress Git operation: " + marker)
        status = git(tree, "status", "--porcelain=v1", "--untracked-files=all", "--ignore-submodules=none")
        if status:
            raise Error("Integration candidate must be clean, including staged/untracked/submodule changes")
        module_output = run(["git", "-C", tree, "submodule", "status", "--recursive"]).stdout.decode()
        if any(line and line[0] in "-+U" for line in module_output.splitlines()):
            raise Error("Integration submodules must be initialized at their committed revisions")
        return {"ref": "refs/heads/" + record["branch"], "oid": head, "base": record["base"],
                "worktree": record["worktree"], "submodules": module_output.strip()}

    def target_snapshot(self, ref):
        if (not ref.startswith("refs/heads/") or
                any(ref == "refs/heads/" + name or ref.startswith("refs/heads/" + name + "/")
                    for name in ("manager", "manager-runtime", "manager-backup")) or
                run(["git", "check-ref-format", ref], check=False).returncode):
            raise Error("Target must be an existing local branch outside manager/backup namespaces")
        return {"ref": ref, "oid": self.direct_commit(ref)}

    def source_snapshot(self, identity):
        item = dict(self.task(identity))
        record = item.get("verification")
        if (item["state"] != "done" or item["acceptance_eligibility"] != "current"
                or not isinstance(record, dict) or not record.get("passed")
                or not self.namespace.matches(record, identity)
                or not self.valid_assignment_id(record.get("id"))
                or record.get("attempt") != item["attempt"]
                or record.get("assignment_id") != item["assignment_id"]
                or any(not isinstance(record.get(k), str) or not re.fullmatch(r"[a-f0-9]{64}", record[k])
                       for k in ("fingerprint", "review_sha256"))):
            raise Error("Source is not a current accepted task: " + identity)
        directory = self.directory(identity)
        expected_review = "tasks/" + identity + "/verification/" + record["id"] + "/review.md"
        if record.get("review") != expected_review:
            raise Error("Invalid source verification review path: " + identity)
        accepted = read_json(directory / "accepted.json")
        report = read_json(directory / "status.json")
        assignment = self.assignment(identity)
        for value in (accepted, report, assignment):
            if (not self.namespace.matches(value, identity) or value.get("attempt") != item["attempt"]
                    or value.get("assignment_id") != item["assignment_id"]):
                raise Error("Source acceptance/report/assignment changed: " + identity)
        if (accepted.get("verification_id") != record["id"] or report.get("state") != "done"
                or read_json(directory / "verification" / record["id"] / "record.json") != record
                or hashlib.sha256(read_bytes(self.home / expected_review)).hexdigest() != record["review_sha256"]):
            raise Error("Source verification evidence changed: " + identity)
        item["worktree_valid"] = (self.worktrees().get(item["worktree"], {}).get("branch") ==
                                  "refs/heads/" + item["branch"] and Path(item["worktree"]).is_dir())
        fingerprint = self.fingerprint(item)
        if fingerprint != record["fingerprint"]:
            raise Error("Accepted source snapshot changed; review and verify again: " + identity)
        return {"task_id": identity, "attempt": item["attempt"], "assignment_id": item["assignment_id"],
                "verification_id": record["id"], "head": git(item["worktree"], "rev-parse", "HEAD"),
                "fingerprint": fingerprint, "acceptance": accepted}

    def combined_snapshot(self, record, target, sources, report_locks=True):
        candidate = self.candidate_snapshot(record)
        destination = self.target_snapshot(target)
        if run(["git", "-C", self.root, "merge-base", "--is-ancestor", destination["oid"], candidate["oid"]], check=False).returncode:
            raise Error("Target must be an ancestor of the committed integration candidate")
        with contextlib.ExitStack() as locks:
            if report_locks:
                for identity in sorted(sources):
                    locks.enter_context(lock(self.directory(identity) / ".report.lock"))
            accepted = [self.source_snapshot(identity) for identity in sorted(sources)]
        return {"candidate": candidate, "target": destination, "sources": accepted}

    def integration_verify(self, args):
        if not args.source or len(args.source) != len(set(args.source)):
            raise Error("Combined verification needs distinct current accepted --source tasks")
        with lock(self.home / ".lock"):
            self.load()
            owner = self.require_owner(args.owner_file)
            self.repair_owner_events()
            self.recover_integration()
            metadata = self.integration_record()
            review = Path(args.review).read_text()
            commands = args.command or list(config(self.root)["verification"].values())
            if not review.strip() or not commands or any(not c.strip() for c in commands):
                raise Error("Combined verification needs an independent review and reviewed check commands")
            snapshot = self.combined_snapshot(metadata, args.target, args.source)
            identity = uuid.uuid4().hex
            evidence = self.home / "integration-verification" / identity
            evidence.mkdir(parents=True)
            atomic_text(evidence / "review.md", review)
            operation = {**self.namespace.envelope(), "resource": "integration", "action": "verify",
                         "id": identity, "state": "running", "generation": owner["generation"],
                         "pid": os.getpid(), "started_at": now(), "snapshot": snapshot,
                         "review_sha256": hashlib.sha256(review.encode()).hexdigest()}
            atomic_json(evidence / "operation.json", operation)
            metadata.update(operation=operation, verification=None, verification_sha256=None)
            atomic_json(self.home / "integration.json", metadata)
            self.touch_owner(args.owner_file)
        checks, error = run_checks(evidence, metadata["worktree"], commands, args.timeout, self.home)
        with lock(self.home / ".lock"):
            self.load()
            try:
                fenced = self.require_owner(args.owner_file)["generation"] != owner["generation"]
            except (Error, OSError, ValueError):
                fenced = True
            after = None
            current = self.integration_record()
            try:
                after = self.combined_snapshot(current, args.target, args.source)
                unchanged = (after == snapshot and (current.get("operation") or {}).get("id") == identity
                             and read_json(evidence / "operation.json") == operation
                             and hashlib.sha256(read_bytes(evidence / "review.md")).hexdigest() == operation["review_sha256"])
            except (Error, OSError, ValueError, KeyError) as exc:
                unchanged, error = False, str(exc)
            passed = not fenced and unchanged and not error and all(c["exit_code"] == 0 for c in checks)
            outcome = "fenced" if fenced else "snapshot_changed" if not unchanged else "passed" if passed else "failed"
            record = {**self.namespace.envelope(), "version": 1, "resource": "integration", "id": identity,
                      "at": now(), "generation": owner["generation"], "passed": passed, "outcome": outcome,
                      "unchanged": unchanged, "snapshot": snapshot, "after_snapshot": after,
                      "review": str((evidence / "review.md").relative_to(self.home)),
                      "review_sha256": operation["review_sha256"], "checks": checks, "diagnostic_error": error}
            atomic_json(evidence / "record.json", record)
            finished = {**operation, "state": outcome, "finished_at": now()}
            atomic_json(evidence / "operation.json", finished)
            if not fenced and (current.get("operation") or {}).get("id") == identity:
                current.update(operation=finished, verification=identity if passed else None,
                               verification_sha256=hashlib.sha256(read_bytes(evidence / "record.json")).hexdigest() if passed else None)
                if passed:
                    current.setdefault("verifications", {})[identity] = current["verification_sha256"]
                atomic_json(self.home / "integration.json", current)
                self.touch_owner(args.owner_file)
            self.event(None, "integration.verified", evidence=identity, passed=passed, outcome=outcome)
            return record

    def recover_integration(self):
        if not (self.home / "integration.json").exists():
            return
        metadata = self.integration_record()
        operation = metadata.get("operation")
        if not operation or operation.get("state") != "running":
            return
        if (not self.namespace.matches(operation) or operation.get("resource") != "integration"
                or operation.get("action") != "verify"
                or not self.valid_assignment_id(operation.get("id"))):
            raise Error("Invalid pending integration operation; preserve and diagnose")
        evidence = self.home / "integration-verification" / operation["id"]
        journal = read_json(evidence / "operation.json")
        if (journal.get("id") != operation["id"] or not self.namespace.matches(journal)
                or journal.get("resource") != "integration" or journal.get("action") != "verify"
                or journal.get("generation") != operation.get("generation")
                or journal.get("snapshot") != operation.get("snapshot")
                or journal.get("state") not in ("running", "fenced", "snapshot_changed", "failed", "passed")):
            raise Error("Integration operation journal mismatch")
        diagnostic = {**journal, "state": journal["state"] if journal.get("state") in
                      ("fenced", "snapshot_changed", "failed") else "interrupted",
                      "recovered_at": now(), "snapshot_matches": None, "diagnostic_error": None}
        try:
            snapshot = journal["snapshot"]
            diagnostic["snapshot_matches"] = (
                self.combined_snapshot(metadata, snapshot["target"]["ref"], [s["task_id"] for s in snapshot["sources"]]) == snapshot
                and hashlib.sha256(read_bytes(evidence / "review.md")).hexdigest() == journal["review_sha256"])
        except (Error, OSError, ValueError, KeyError) as exc:
            diagnostic["diagnostic_error"] = str(exc)
        atomic_json(evidence / "operation.json", diagnostic)
        metadata.update(operation=diagnostic, verification=None, verification_sha256=None)
        atomic_json(self.home / "integration.json", metadata)
        self.event(None, "integration.operation_interrupted", operation_id=operation["id"])

    def integration_status(self, verification=None):
        if not (self.home / "integration.json").exists():
            return {**self.namespace.envelope(), "initialized": False, "eligible": False}
        metadata = self.integration_record()
        result = {**metadata, "initialized": metadata["state"] == "ready", "eligible": False,
                  "verification_id": verification or metadata.get("verification"), "diagnostic_error": None}
        if metadata["state"] != "ready":
            result["diagnostic_error"] = "Integration initialization pending"
            return result
        try:
            self.integration_identity(metadata)
        except (Error, OSError, ValueError) as exc:
            result["diagnostic_error"] = str(exc)
            return result
        identity = result["verification_id"]
        if identity is None:
            return result
        if not self.valid_assignment_id(identity):
            raise Error("Invalid combined verification ID")
        evidence = self.home / "integration-verification" / identity
        record = read_json(evidence / "record.json")
        try:
            if (not self.namespace.matches(record) or record.get("resource") != "integration"
                    or record.get("id") != identity or not record.get("passed")
                    or record.get("review") != "integration-verification/" + identity + "/review.md"
                    or (metadata.get("operation") or {}).get("state") == "running"):
                raise Error("Combined verification is unsuccessful or an operation is pending")
            if hashlib.sha256(read_bytes(evidence / "record.json")).hexdigest() != metadata.get("verifications", {}).get(identity):
                raise Error("Combined verification record changed")
            snapshot = record["snapshot"]
            current = self.combined_snapshot(metadata, snapshot["target"]["ref"], [s["task_id"] for s in snapshot["sources"]], report_locks=False)
            if (current != snapshot or hashlib.sha256(read_bytes(evidence / "review.md")).hexdigest() != record["review_sha256"]):
                raise Error("Combined candidate/target/source/review snapshot changed; verify again")
            if READ_FILES is not None and current != self.combined_snapshot(
                    metadata, snapshot["target"]["ref"], [s["task_id"] for s in snapshot["sources"]], report_locks=False):
                raise Error("Runtime busy/inconsistent integration snapshot; retry")
            result["eligible"] = True
        except (Error, OSError, ValueError, KeyError) as exc:
            result["diagnostic_error"] = str(exc)
        result["record"] = record
        return result

    def delivery_id(self, verification):
        if not self.valid_assignment_id(verification):
            raise Error("Invalid combined verification ID")
        # Stable across retries/handoffs; canonical root prevents cross-root collisions.
        return hashlib.sha256(json.dumps([str(self.root), self.manager_id, verification]).encode()).hexdigest()[:32]

    def delivery_proof(self, verification):
        self.delivery_id(verification)
        metadata = self.integration_record()
        evidence = self.home / "integration-verification" / verification / "record.json"
        record = read_json(evidence)
        digest = hashlib.sha256(read_bytes(evidence)).hexdigest()
        if (not self.namespace.matches(record) or record.get("resource") != "integration"
                or record.get("id") != verification or record.get("passed") is not True
                or digest != metadata["verifications"].get(verification)):
            raise Error("Delivery requires owner-committed successful combined evidence")
        return record, digest

    def delivery_inventory(self, target):
        output = run(["git", "-C", self.root, "worktree", "list", "--porcelain", "-z"]).stdout
        if not output.endswith(b"\0\0"):
            raise Error("Unreadable/incomplete worktree inventory")
        inventory, paths = [], set()
        for block in output[:-2].decode(errors="surrogateescape").split("\0\0"):
            fields = block.split("\0")
            if not fields[0].startswith("worktree ") or not fields[0][9:]:
                raise Error("Invalid worktree inventory entry")
            entry = {"worktree": str(Path(fields[0][9:]).resolve())}
            for field in fields[1:]:
                key, _, value = field.partition(" ")
                if key not in ("HEAD", "branch", "detached", "bare", "locked", "prunable") or key in entry:
                    raise Error("Invalid/duplicate worktree inventory field")
                entry[key] = value
            if (entry["worktree"] in paths or ("bare" not in entry and
                    (not re.fullmatch(r"[a-f0-9]{40}|[a-f0-9]{64}", entry.get("HEAD", ""))
                     or ("branch" in entry) == ("detached" in entry)))):
                raise Error("Ambiguous/incomplete worktree inventory")
            paths.add(entry["worktree"])
            inventory.append(entry)
            if entry.get("branch") == target:
                raise Error("Delivery target is checked out in a registered worktree (including missing/locked entries): " + entry["worktree"])
        return inventory

    @contextlib.contextmanager
    def delivery_gate(self, args):
        with contextlib.ExitStack() as locks:
            locks.enter_context(lock(self.control / "maintenance.lock"))
            locks.enter_context(lock(self.control / "delivery.lock"))
            locks.enter_context(lock(self.home / ".integration.operation.lock", nonblocking=True))
            locks.enter_context(lock(self.home / ".lock"))
            self.load()
            self.require_owner(args.owner_file)
            yield

    def delivery_intent(self, verification):
        identity = self.delivery_id(verification)
        path = reject_symlinks(self.control / "deliveries" / identity / "intent.json")
        if not path.exists():
            return None
        intent = read_json(path)
        proof, digest = self.delivery_proof(verification)
        snapshot = proof["snapshot"]
        if (not self.namespace.matches(intent) or type(intent.get("version")) is not int or intent.get("version") != 1
                or intent.get("id") != identity or intent.get("verification_id") != verification
                or intent.get("git_common_dir") != str(self.common)
                or type(intent.get("generation")) is not int or intent["generation"] < 1
                or intent.get("evidence_sha256") != digest
                or intent.get("target") != snapshot["target"]["ref"]
                or intent.get("old_oid") != snapshot["target"]["oid"]
                or intent.get("candidate_ref") != snapshot["candidate"]["ref"]
                or intent.get("new_oid") != snapshot["candidate"]["oid"]
                or intent.get("receipt_ref") != "refs/manager-runtime/deliveries/" + identity):
            raise Error("Delivery intent identity/evidence mismatch; preserve and diagnose")
        return intent

    def delivery_result(self, path, intent):
        reject_symlinks(path)
        if not path.exists():
            return {}
        result = read_json(path)
        if (any(result.get(k) != v for k, v in intent.items())
                or result.get("state") not in ("committed", "not_committed", "ambiguous", "external_change", "transaction_rejected")
                or type(result.get("committed_once")) is not bool
                or type(result.get("transaction_rejected")) is not bool
                or not isinstance(result.get("errors"), list)
                or any(not isinstance(e, dict) or not isinstance(e.get("error"), str)
                       or not isinstance(e.get("at"), str) for e in result["errors"])):
            raise Error("Delivery result identity/metadata mismatch; preserve and diagnose")
        return result

    def receipt_state(self, intent):
        ref = intent["receipt_ref"]
        result_path = reject_symlinks(self.control / "deliveries" / intent["id"] / "result.json")
        previous = self.delivery_result(result_path, intent)
        if run(["git", "-C", self.root, "symbolic-ref", "-q", ref], check=False).returncode == 0:
            return "ambiguous"
        receipt = run(["git", "-C", self.root, "show-ref", "--verify", "--hash", ref], check=False)
        if receipt.returncode == 0:
            return "committed" if (receipt.stdout.decode().strip() == intent["new_oid"]
                                   and not previous.get("transaction_rejected")) else "ambiguous"
        # show-ref uses 128 for a missing ref too; inventory distinguishes absence
        # from command/corruption errors rather than treating every error as absence.
        refs = git(self.root, "for-each-ref", "--format=%(refname)", ref).splitlines()
        if ref in refs:
            return "ambiguous"
        manager_path = reject_symlinks(self.home / "delivery" / (intent["id"] + ".json"))
        for path in (result_path, manager_path):
            if self.delivery_result(path, intent).get("committed_once"):
                return "ambiguous"  # A lost receipt never allows re-delivery.
        try:
            target = self.direct_commit(intent["target"])
        except Error:
            return "external_change"
        return "not_committed" if target == intent["old_oid"] else "external_change"

    def save_delivery_result(self, intent, state, error=None):
        path = self.control / "deliveries" / intent["id"] / "result.json"
        previous = self.delivery_result(path, intent)
        historical = self.delivery_result(self.home / "delivery" / (intent["id"] + ".json"), intent)
        errors = list((previous or historical).get("errors", []))
        if error is not None:
            errors.append({"at": now(), "error": error})
        result = {**intent, "state": state, "diagnostic_error": error, "errors": errors,
                  "committed_once": state == "committed" or bool(previous.get("committed_once")) or bool(historical.get("committed_once")),
                  "transaction_rejected": state == "transaction_rejected" or
                  (state != "committed" and bool(previous.get("transaction_rejected")))}
        if not path.exists() or read_json(path) != result:
            atomic_json(path, result)
        if state == "committed":
            directory = reject_symlinks(self.home / "delivery")
            directory.mkdir(exist_ok=True)
            sync_directory(self.home)
            receipt = directory / (intent["id"] + ".json")
            if self.delivery_result(receipt, intent) != result:
                atomic_json(receipt, result)
        return result

    def delivery_transaction(self, intent):
        transaction = ("start\noption no-deref\nverify " + intent["candidate_ref"] + " " + intent["new_oid"] +
                       "\noption no-deref\nupdate " + intent["target"] + " " + intent["new_oid"] + " " + intent["old_oid"] +
                       "\noption no-deref\ncreate " + intent["receipt_ref"] + " " + intent["new_oid"] +
                       "\nprepare\ncommit\n")
        result = run(["git", "-C", self.root, "update-ref", "--stdin"], data=transaction.encode(), check=False)
        if result.returncode:
            raise Error("Delivery ref transaction rejected: " + result.stderr.decode(errors="replace").strip())

    def deliver(self, args):
        self.load()
        self.require_owner(args.owner_file)
        existing = self.delivery_intent(args.verification)
        if existing is None:
            # No common locks while discovering missing/stale evidence or decisions.
            status = self.integration_status(args.verification)
            if not status["eligible"]:
                raise Error(status.get("diagnostic_error") or "Combined verification is not eligible")
        with self.delivery_gate(args):
            existing = self.delivery_intent(args.verification)
            if existing:
                state = self.receipt_state(existing)
                if state == "committed":
                    return self.save_delivery_result(existing, state)
                if state != "not_committed":
                    self.save_delivery_result(existing, state)
                    raise Error("Delivery " + state + "; preserve intent/receipt and diagnose")
            proof, digest = self.delivery_proof(args.verification)
            # Hold source report locks through the transaction, so report writers
            # cannot race the final evidence check. Registry fences owner/task writes.
            with contextlib.ExitStack() as reports:
                for identity in sorted(s["task_id"] for s in proof["snapshot"]["sources"]):
                    reports.enter_context(lock(self.directory(identity) / ".report.lock"))
                status = self.integration_status(args.verification)
                if not status["eligible"]:
                    raise Error(status.get("diagnostic_error") or "Combined verification is not eligible")
                snapshot = proof["snapshot"]
                inventory = self.delivery_inventory(snapshot["target"]["ref"])
                reject_symlinks(self.home / "delivery" / (self.delivery_id(args.verification) + ".json"))
                intent = existing or {**self.namespace.envelope(), "version": 1,
                    "id": self.delivery_id(args.verification), "git_common_dir": str(self.common),
                    "generation": self.require_owner(args.owner_file)["generation"], "created_at": now(),
                    "verification_id": args.verification, "evidence_sha256": digest,
                    "target": snapshot["target"]["ref"], "old_oid": snapshot["target"]["oid"],
                    "candidate_ref": snapshot["candidate"]["ref"], "new_oid": snapshot["candidate"]["oid"],
                    "receipt_ref": "refs/manager-runtime/deliveries/" + self.delivery_id(args.verification),
                    "inventory": inventory}
                directory = reject_symlinks(self.control / "deliveries" / intent["id"])
                result_path = reject_symlinks(directory / "result.json")
                if existing is None:
                    manager_receipt = self.home / "delivery" / (intent["id"] + ".json")
                    if result_path.exists() or manager_receipt.exists():
                        raise Error("Unregistered delivery result exists; preserve and diagnose")
                    ref = intent["receipt_ref"]
                    if (run(["git", "-C", self.root, "symbolic-ref", "-q", ref], check=False).returncode == 0
                            or ref in git(self.root, "for-each-ref", "--format=%(refname)", ref).splitlines()):
                        raise Error("Unregistered delivery receipt ref exists; preserve and diagnose")
                directory.mkdir(parents=True, exist_ok=True)
                sync_directory(self.control)
                sync_directory(directory.parent)
                if existing is None:
                    atomic_json(directory / "intent.json", intent)
                try:
                    self.delivery_transaction(intent)
                except Error as exc:
                    state = "transaction_rejected" if str(exc).startswith("Delivery ref transaction rejected:") else self.receipt_state(intent)
                    self.save_delivery_result(intent, state, str(exc))
                    raise
                return self.save_delivery_result(intent, "committed")

    def reconcile_deliveries(self, args):
        directory = reject_symlinks(self.control / "deliveries")
        if not directory.exists():
            return []
        with self.delivery_gate(args):
            results = []
            for path in read_directory(directory):
                if not self.valid_assignment_id(path.name):
                    continue  # Preserve unknown artifacts; never adopt them.
                intent_path = reject_symlinks(path / "intent.json")
                if not intent_path.exists():
                    continue
                identity = read_json(intent_path)
                if not self.namespace.matches(identity):
                    continue
                intent = self.delivery_intent(identity.get("verification_id"))
                if intent is None or intent["id"] != path.name:
                    raise Error("Delivery journal path/identity mismatch")
                results.append(self.save_delivery_result(intent, self.receipt_state(intent)))
            return results

    def escalate(self, args):
        self.reconcile()
        item = self.task(args.id)
        if item["state"] != "needs_manager":
            raise Error("escalate requires a worker question in needs_manager")
        item.update(state="needs_user", summary=args.reason, verification=None)
        self.save()
        self.event(args.id, "manager.needs_user", reason=args.reason)
        return item


def parser():
    cli = argparse.ArgumentParser(description=__doc__)
    cli.add_argument("--root", default=os.getcwd(), help="Project checkout, before the subcommand")
    cli.add_argument("--manager-id", type=manager_id, help="Explicit manager selector, before the subcommand")
    cli.add_argument("--owner-file", default=os.environ.get("MANAGER_OWNER_FILE"),
                     help="Private owner credential for management writes")
    sub = cli.add_subparsers(dest="action", required=True)
    for name in ("init", "managers", "status", "reconcile", "events"):
        sub.add_parser(name)
    p = sub.add_parser("owner")
    owner = p.add_subparsers(dest="owner_action", required=True)
    owner.add_parser("status")
    owner.add_parser("release")
    for name in ("claim", "takeover"):
        p = owner.add_parser(name)
        p.add_argument("--session-id", required=True)
        p.add_argument("--credential-file", required=True)
        if name == "takeover":
            p.add_argument("--expect-generation", type=int, required=True)
            p.add_argument("--reason", required=True)
    for name in ("task", "spawn"):
        p = sub.add_parser(name)
        p.add_argument("--id", required=True, type=task_id)
        p.add_argument("--title")
        p.add_argument("--brief", help="Path to a populated Markdown brief")
        p.add_argument("--agent", choices=("auto", "codex", "claude"), default="auto")
        p.add_argument("--kind", choices=("implementation", "research", "review", "verification"), default="implementation")
        p.add_argument("--base", default="HEAD", help="Committed base containing prerequisites")
        p.add_argument("--depends-on", type=task_id, action="append")
    p = sub.add_parser("send")
    p.add_argument("id", type=task_id)
    p.add_argument("message", nargs="?")
    p.add_argument("--message-file")
    p.add_argument("--inbox-only", action="store_true")
    for name in ("peek", "stop", "inbox", "accept"):
        p = sub.add_parser(name)
        p.add_argument("id", type=task_id)
    p = sub.add_parser("retry")
    p.add_argument("id", type=task_id)
    p.add_argument("--agent", choices=("auto", "codex", "claude"))
    p = sub.add_parser("report")
    p.add_argument("id", type=task_id)
    p.add_argument("--attempt", required=True, type=int)
    p.add_argument("--assignment-id", help="Launch identity; defaults to MANAGER_WORKER_ASSIGNMENT")
    p.add_argument("--state", choices=sorted(WORKER_STATES), required=True)
    p.add_argument("--summary", required=True)
    p.add_argument("--question")
    p.add_argument("--question-type", choices=("technical", "product", "permission", "scope"), default="technical")
    p.add_argument("--option", action="append", default=[])
    p.add_argument("--file", action="append", default=[])
    p.add_argument("--test-command")
    p.add_argument("--test-result", choices=("passed", "failed", "not_run"))
    p.add_argument("--ack", action="append", default=[])
    p = sub.add_parser("verify")
    p.add_argument("id", type=task_id)
    p.add_argument("--review", required=True, help="Independent review of diff and acceptance criteria")
    p.add_argument("--command", action="append", help="Reviewed shell command, repeatable")
    p.add_argument("--timeout", type=int, default=600, help="Seconds per check")
    p = sub.add_parser("escalate")
    p.add_argument("id", type=task_id)
    p.add_argument("--reason", required=True)
    p = sub.add_parser("integration")
    integration = p.add_subparsers(dest="integration_action", required=True)
    p = integration.add_parser("init")
    p.add_argument("--base", required=True, help="Explicit committed integration base")
    p = integration.add_parser("status")
    p.add_argument("--verification", help="Check a specific retained combined verification")
    p = integration.add_parser("verify")
    p.add_argument("--target", required=True, help="Existing full local branch ref")
    p.add_argument("--source", type=task_id, required=True, action="append")
    p.add_argument("--review", required=True)
    p.add_argument("--command", action="append")
    p.add_argument("--timeout", type=int, default=600)
    p = sub.add_parser("deliver", help="Authorized fast-forward of an existing un-checked-out local branch")
    p.add_argument("--verification", required=True)
    return cli


def list_managers(root):
    runtime = Runtime(root, inventory=True)
    container = runtime.namespace.container
    entries = []
    if container.exists():
        for path in read_directory(container):
            try:
                manager_id(path.name)
                reject_symlinks(path)
                item = Runtime(runtime.root, path.name, inventory=True)
                item.load()
                entries.append({"manager_id": path.name, "version": 2,
                                "owner": item.owner_summary(),
                                "max_workers": config(item.root)["manager"]["max_workers"]})
            except (Error, OSError, ValueError, argparse.ArgumentTypeError) as exc:
                entries.append({"manager_id": path.name, "error": str(exc)})
    result = {"root": str(runtime.root), "managers": entries, "capacity_scope": "per-manager"}
    try:
        runtime.namespace.legacy_check()
    except ValueError as exc:
        result["legacy_error"] = str(exc)
    return result


def read_action(runtime, args):
    runtime.load()
    if args.action == "integration":
        return runtime.integration_status(args.verification)
    if args.action == "status":
        saved = json.loads(json.dumps(runtime.state))
        observed = runtime.reconcile(persist=False)
        return {"root": str(runtime.root), "manager_id": runtime.manager_id,
                "tasks": list(saved["tasks"].values()), "observed": observed,
                "worker_capacity": observed["worker_capacity"], "owner": runtime.owner_summary(),
                "integration": runtime.integration_status()}
    if args.action == "owner":
        result = runtime.owner_summary()
        result["owner_operations"] = [{"id": r["id"], "action": r["action"], "state": r["state"],
                                       "generation": r["owner"]["generation"],
                                       "credential_file": r["event"].get("credential_file")}
                                      for r in runtime.owner_operations()]
        result["pending_owner_operations"] = [r for r in result["owner_operations"] if r["state"] == "pending"]
        result["pending_operations"] = [t["operation"] for t in runtime.state["tasks"].values()
                                        if (t.get("operation") or {}).get("state") == "running"]
        if (runtime.home / "integration.json").exists():
            operation = runtime.integration_record().get("operation")
            if operation and operation.get("state") == "running":
                result["pending_operations"].append(operation)
        if args.owner_file:
            try:
                runtime.require_owner(args.owner_file)
                result["credential_valid"] = True
            except (Error, OSError, ValueError):
                result["credential_valid"] = False
        return result
    if args.action == "events":
        events = []
        for folder in read_directory(runtime.home / "events"):
            if folder.is_dir():
                for path in read_directory(folder):
                    if path.suffix == ".json":
                        event = read_json(path)
                        if not runtime.namespace.matches(event, event.get("task_id")):
                            raise Error("Invalid event namespace identity")
                        events.append(event)
        return sorted(events, key=lambda e: (e["at"], e.get("task_id") or ""))
    if args.action == "inbox":
        runtime.task(args.id)
        return runtime.inbox(args.id)
    if args.action == "peek":
        item = runtime.task(args.id)
        pane = runtime.panes().get(item["window"])
        if not pane:
            raise Error("No pane; inspect the task's preserved log.txt instead")
        output = run(["tmux", "capture-pane", "-p", "-t", pane["id"], "-S", "-200"])
        return {**runtime.namespace.envelope(args.id), "output": output.stdout.decode(errors="replace")}
    raise Error("Unknown read action")


def main():
    global READ_FILES, READ_DIRS
    args = parser().parse_args()
    readonly = args.action in ("managers", "status", "peek", "events", "inbox") or (
        args.action == "owner" and args.owner_action == "status") or (
        args.action == "integration" and args.integration_action == "status")
    if readonly:
        READ_FILES, READ_DIRS = {}, {}
    try:
        worker_keys = ("MANAGER_WORKER_ROOT", "MANAGER_WORKER_MANAGER", "MANAGER_WORKER_TASK",
                       "MANAGER_WORKER_ATTEMPT", "MANAGER_WORKER_ASSIGNMENT")
        worker = any(os.environ.get(k) for k in worker_keys)
        if worker and (not all(os.environ.get(k) for k in worker_keys) or
                       args.action not in ("report", "inbox") or
                       args.id != os.environ.get("MANAGER_WORKER_TASK")):
            raise Error("Worker sessions can only report and read their own inbox with complete launch identity")
        if args.action not in ("init", "managers") and not args.manager_id:
            raise Error("--manager-id is required; no implicit current manager")
        if args.action == "managers":
            if args.manager_id:
                raise Error("managers lists all namespaces; do not provide a selector")
            result = list_managers(args.root)
        else:
            identity = args.manager_id
            if identity is None:
                initial = Runtime(args.root)
                while True:
                    identity = generated_id()
                    if not (initial.namespace.container / identity).exists():
                        break
            runtime = Runtime(args.root, identity)
            if worker and (os.environ["MANAGER_WORKER_ROOT"] != str(runtime.root) or
                           os.environ["MANAGER_WORKER_MANAGER"] != identity):
                raise Error("Worker root/manager selector does not match its launch identity")
            if args.action == "report":
                supplied = args.assignment_id
                launched = os.environ.get("MANAGER_WORKER_ASSIGNMENT")
                if supplied and launched and supplied != launched:
                    raise Error("Assignment ID conflicts with worker launch identity")
                args.assignment_id = supplied or launched
                if not runtime.valid_assignment_id(args.assignment_id):
                    raise Error("report requires a valid --assignment-id from assignment.json")
                if worker and str(args.attempt) != os.environ["MANAGER_WORKER_ATTEMPT"]:
                    raise Error("Worker attempt does not match its launch generation")
                runtime.load()
                result = runtime.report(args)
            elif args.action == "init":
                result = runtime.init()
                # An automatic ID collision never silently opens another working unit.
                while not args.manager_id and not result["initialized"]:
                    runtime = Runtime(args.root, generated_id())
                    result = runtime.init()
            elif readonly:
                if worker:
                    runtime.load()
                    assignment = runtime.assignment(args.id)
                    if (str(assignment["attempt"]) != os.environ["MANAGER_WORKER_ATTEMPT"] or
                            assignment["assignment_id"] != os.environ["MANAGER_WORKER_ASSIGNMENT"]):
                        raise Error("Stale worker inbox identity")
                result = read_action(runtime, args)
            elif args.action == "deliver":
                result = runtime.deliver(args)
            elif args.action == "integration":
                runtime.load()
                runtime.require_owner(args.owner_file)
                if args.integration_action == "verify" and args.timeout < 1:
                    raise Error("--timeout must be positive")
                with contextlib.ExitStack() as locks:
                    if args.integration_action == "init":
                        locks.enter_context(lock(runtime.control / "maintenance.lock"))
                    locks.enter_context(lock(runtime.home / ".integration.operation.lock", nonblocking=True))
                    runtime.integration_locked = True
                    result = getattr(runtime, "integration_" + args.integration_action)(args)
            else:
                if args.action == "send" and (args.message is None) == (args.message_file is None):
                    raise Error("Provide one message or --message-file")
                if args.action == "verify" and args.timeout < 1:
                    raise Error("--timeout must be positive")
                runtime.load()  # Diagnose corrupt/foreign state before opening any write lock.
                if args.action != "owner" or args.owner_action == "release":
                    runtime.require_owner(args.owner_file)
                deliveries = []
                if args.action == "reconcile":
                    try:
                        deliveries = runtime.reconcile_deliveries(args)
                    except Error as exc:
                        if "Runtime busy:" not in str(exc):
                            raise
                        deliveries = [{"state": "operation_busy", "diagnostic_error": str(exc)}]
                with contextlib.ExitStack() as locks:
                    if args.action in ("spawn", "retry"):
                        locks.enter_context(lock(runtime.control / "maintenance.lock"))
                    if args.action == "reconcile" and (runtime.home / "integration.json").exists():
                        try:
                            locks.enter_context(lock(runtime.home / ".integration.operation.lock", nonblocking=True))
                            runtime.integration_locked = True
                        except Error:
                            pass  # Reconcile diagnoses busy integration without waiting.
                    known_tasks = set(runtime.state["tasks"])
                    if args.action != "owner":
                        target = getattr(args, "id", None)
                        for task in sorted(known_tasks):
                            if args.action == "verify" and task != target:
                                runtime.busy_tasks.add(task)
                                continue
                            try:
                                locks.enter_context(lock(runtime.directory(task) / ".operation.lock", nonblocking=True))
                            except Error:
                                if task == target:
                                    raise
                                runtime.busy_tasks.add(task)
                    if args.action == "verify":
                        if args.id not in known_tasks:
                            raise Error("Unknown task: " + args.id)
                        result = runtime.verify(args)
                    else:
                        locks.enter_context(lock(runtime.home / ".lock"))
                        runtime.load()
                        if args.action == "owner":
                            # Validate before journal repairs; no stale credential may write.
                            if args.owner_action == "release":
                                runtime.require_owner(args.owner_file)
                            runtime.repair_owner_events()
                            result = runtime.change_owner(args)
                        else:
                            runtime.require_owner(args.owner_file)
                            runtime.repair_owner_events()
                            runtime.busy_tasks.update(set(runtime.state["tasks"]) - known_tasks)
                            if getattr(args, "id", None) in runtime.busy_tasks:
                                raise Error("Task changed during lock acquisition; retry")
                            runtime.recover_operations()
                            if runtime.integration_locked:
                                runtime.recover_integration()
                            if args.action == "reconcile":
                                result = runtime.reconcile()
                                result["deliveries"] = deliveries
                                result["integration"] = runtime.integration_status()
                                if not runtime.integration_locked and (runtime.home / "integration.json").exists():
                                    result["notices"].append({"resource": "integration", "issue": "operation_busy"})
                            elif args.action in ("task", "spawn"):
                                existing = args.id in runtime.state["tasks"]
                                if existing and args.action == "task":
                                    raise Error("Task already exists")
                                if existing and (args.title or args.brief or args.depends_on or args.base != "HEAD"):
                                    raise Error("Existing task definitions cannot be overwritten by spawn")
                                item = runtime.task(args.id) if existing else runtime.register(args)
                                result = item if args.action == "task" else runtime.launch(
                                    item, args.agent if args.agent != "auto" else None)
                            else:
                                result = getattr(runtime, args.action)(args)
                            runtime.touch_owner(args.owner_file)
        if readonly:
            check_read_consistency()
        emit(result)
        checking = args.action == "verify" or (args.action == "integration" and args.integration_action == "verify")
        return 1 if checking and not result["passed"] else 0
    except (Error, OSError, ValueError, argparse.ArgumentTypeError) as exc:
        emit({"error": str(exc)})
        return 1


if __name__ == "__main__":
    sys.exit(main())
